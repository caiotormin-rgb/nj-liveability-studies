# ─────────────────────────────────────────────────────────────────────────────
# NJ Pipeline – API Keys & Configuration
# Copy this file to .env and fill in your keys.
# Get keys at the URLs below (all free).
# ─────────────────────────────────────────────────────────────────────────────

# US Census Bureau API key (required for ACS data)
# Register at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_api_key_here

# Bureau of Labor Statistics API key (optional – v1 API works without a key)
# Register at: https://data.bls.gov/registrationEngine/
BLS_API_KEY=your_bls_api_key_here

# FBI Crime Data Explorer API key
# Register at: https://api.data.gov/signup/
FBI_API_KEY=your_fbi_api_key_here

# HUD User API key (for CHAS housing affordability data)
# Register at: https://www.huduser.gov/hudapi/public/register?comingfrom=login
HUD_API_KEY=your_hud_api_key_here

# NOAA Climate Data Online token
# Request at: https://www.ncei.noaa.gov/cdo-web/token
NOAA_API_KEY=your_noaa_token_here

# Zillow – no API key needed for CSV downloads
# NJ Open Data (Socrata) – no key needed but optional for higher rate limits
# FEMA OpenFEMA – no key needed
# CDC PLACES – no key needed
