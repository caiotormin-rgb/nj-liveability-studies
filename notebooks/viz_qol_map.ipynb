   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Geographic Distribution of QoL Scores\\n\",\n",
    "    \"This notebook visualizes the geographic distribution of the computed Quality of Life (QoL) scores across New Jersey ZIP codes.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import duckdb\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import geopandas as gpd\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import urllib.request\\n\",\n",
    "    \"import zipfile\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import matplotlib.patheffects as pe\\n\",\n",
    "    \"\\n\",\n",
    "    \"DB_PATH = '../data/db/nj_pipeline.duckdb'\\n\",\n",
    "    \"con = duckdb.connect(DB_PATH, read_only=True)\\n\",\n",
    "    \"print('Connected to DuckDB')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load QoL Scores\\n\",\n",
    "    \"qol_scores = con.execute(\\\"SELECT zip_code, qol_score, qol_rank, city, zillow_county FROM qol_scores\\\").df()\\n\",\n",
    "    \"print(f\\\"Loaded {len(qol_scores)} QoL scores\\\")\\n\",\n",
    "    \"qol_scores.head()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Download NJ ZIP Code Tabulation Areas (ZCTAs) shapefile from Census if not exists\\n\",\n",
    "    \"shapefile_dir = '../data/raw/shapefiles'\\n\",\n",
    "    \"os.makedirs(shapefile_dir, exist_ok=True)\\n\",\n",
    "    \"zip_path = os.path.join(shapefile_dir, 'cb_2020_us_zcta520_500k.zip')\\n\",\n",
    "    \"\\n\",\n",
    "    \"if not os.path.exists(zip_path):\\n\",\n",
    "    \"    print(\\\"Downloading ZCTA shapefile...\\\")\\n\",\n",
    "    \"    url = \\\"https://www2.census.gov/geo/tiger/GENZ2020/shp/cb_2020_us_zcta520_500k.zip\\\"\\n\",\n",
    "    \"    try:\\n\",\n",
    "    \"        req = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})\\n\",\n",
    "    \"        with urllib.request.urlopen(req) as response, open(zip_path, 'wb') as out_file:\\n\",\n",
    "    \"            out_file.write(response.read())\\n\",\n",
    "    \"        print(\\\"Download complete.\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"        with zipfile.ZipFile(zip_path, 'r') as zip_ref:\\n\",\n",
    "    \"            zip_ref.extractall(shapefile_dir)\\n\",\n",
    "    \"    except Exception as e:\\n\",\n",
    "    \"        print(f\\\"Error downloading: {e}\\\")\\n\",\n",
    "    \"        \\n\",\n",
    "    \"# Load ZCTAs\\n\",\n",
    "    \"print(\\\"Loading ZCTA shapefile...\\\")\\n\",\n",
    "    \"gdf = gpd.read_file(os.path.join(shapefile_dir, 'cb_2020_us_zcta520_500k.shp'))\\n\",\n",
    "    \"gdf = gdf.rename(columns={'ZCTA5CE20': 'zip_code'})\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Merge QoL scores with GeoDataFrame\\n\",\n",
    "    \"nj_gdf = gdf.merge(qol_scores, on='zip_code', how='inner')\\n\",\n",
    "    \"print(f\\\"Merged GeoDataFrame has {len(nj_gdf)} rows\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Plot Geographic Distribution of QoL\\n\",\n",
    "    \"fig, ax = plt.subplots(1, 1, figsize=(12, 16))\\n\",\n",
    "    \"nj_gdf.plot(column='qol_score', \\n\",\n",
    "    \"            cmap='RdYlGn', \\n\",\n",
    "    \"            linewidth=0.5, \\n\",\n",
    "    \"            ax=ax, \\n\",\n",
    "    \"            edgecolor='0.5', \\n\",\n",
    "    \"            legend=True, \\n\",\n",
    "    \"            legend_kwds={'label': \\\"Quality of Life Score (0-100)\\\", 'orientation': \\\"vertical\\\", 'shrink': 0.6})\\n\",\n",
    "    \"\\n\",\n",
    "    \"ax.set_title(\\\"New Jersey Quality of Life Index by ZIP Code\\\", fontsize=16)\\n\",\n",
    "    \"ax.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add top 10 labels\\n\",\n",
    "    \"top_zips = nj_gdf.nlargest(10, 'qol_score')\\n\",\n",
    "    \"for idx, row in top_zips.iterrows():\\n\",\n",
    "    \"    x = row.geometry.centroid.x\\n\",\n",
    "    \"    y = row.geometry.centroid.y\\n\",\n",
    "    \"    plt.annotate(text=row['city'], xy=(x, y), \\n\",\n",
    "    \"                 xytext=(3, 3), textcoords=\\\"offset points\\\", fontsize=8, color='black', weight='bold',\\n\",\n",
    "    \"                 path_effects=[pe.withStroke(linewidth=2, foreground=\\\"white\\\")])\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"os.makedirs('../NJ_Analysis_Vault/EDA Findings', exist_ok=True)\\n\",\n",
    "    \"plt.savefig('../NJ_Analysis_Vault/EDA Findings/qol_map.png', dpi=300, bbox_inches='tight')\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
    " \"metadata\": {\n",
    "  \"kernelspec\": {\n",
    "   \"display_name\": \"Python 3\",\n",
    "   \"language\": \"python\",\n",
    "   \"name\": \"python3\"\n",
    "  }\n",
